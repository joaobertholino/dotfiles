window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^[Qq]alculate-gtk$"#
    open-floating true
    default-column-width { fixed 570; }
    default-window-height { fixed 495; }
}
window-rule {
    match app-id=r#"^[Pp]avucontrol$"#
    match app-id=r#"^[Gg]igolo$"#
    open-floating true
}
window-rule {
    match app-id=r#"^TUI[.]zencal$"#
    open-floating true
    default-column-width { fixed 320; }
    default-window-height { fixed 240; }
}
window-rule {
    match app-id=r#"^TUI[.]systeminfo$"#
    open-floating true
    default-column-width { fixed 650; }
    default-window-height { fixed 650; }
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
