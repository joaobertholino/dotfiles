binds {
    Mod+Return { spawn "alacritty"; }
    Mod+Space { spawn "fuzzel" "--config" "/home/joaob/.config/niri/fuzzel.ini"; }
    Mod+Ctrl+L { spawn "systemctl" "--user" "start" "niri-lock.service"; }
    Mod+Alt+E { spawn "emacs"; }
    Mod+Alt+C { spawn "qalculate-gtk"; }
    Mod+Alt+B { spawn "firefox-bin"; }
    Mod+Alt+X { spawn "xournalpp"; }
    Mod+Alt+Q { quit; }
    Mod+Escape { spawn "/home/joaob/.config/niri/scripts/reload-config"; }
    Mod+Alt+R { spawn "/home/joaob/.config/niri/scripts/reload-config"; }
    Mod+Alt+O { spawn "/home/joaob/.config/niri/scripts/toggle-orientation"; }
    Mod+V { spawn "/home/joaob/.config/niri/scripts/clipboard-history"; }
    Mod+Shift+V { spawn "/home/joaob/.config/niri/scripts/clipboard-history" "--clear"; }
    Mod+Ctrl+N { spawn "/home/joaob/.config/niri/scripts/night-light-toggle"; }
    Mod+Alt+P { spawn "hyprpicker" "-a"; }
    Mod+Alt+A { spawn "hyprpwcenter"; }
    Mod+Alt+I { spawn "/home/joaob/.config/niri/scripts/system-info"; }
    Mod+Ctrl+Escape { spawn "/home/joaob/.config/niri/scripts/power-menu"; }
    Mod+W { close-window; }
    Mod+Shift+W { close-window; }
    Mod+F { fullscreen-window; }
    Mod+M { maximize-column; }
    Mod+T { toggle-window-floating; }
    Mod+S { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+Y { move-column-left; }
    Mod+G { focus-column-first; }
    Mod+P { toggle-column-tabbed-display; }
    Mod+B { focus-column-first; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft { focus-workspace-up; }
    Mod+BracketRight { focus-workspace-down; }
    Mod+Tab { focus-workspace-previous; }
    Mod+grave { focus-workspace-previous; }
    Mod+O { toggle-overview; }
    Mod+I { focus-window-previous; }
    Mod+R { switch-preset-column-width; }
    Mod+Ctrl+Y { expand-column-to-available-width; }
    Print { screenshot; }
    Shift+Print { screenshot-window; }
    Mod+Print { screenshot-screen; }
    Ctrl+Print { screenshot; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+H { focus-column-left; }
    Mod+Shift+H { move-column-left; }
    Mod+Alt+Shift+H { move-column-left; }
    Mod+J { focus-window-down; }
    Mod+Shift+J { move-window-down; }
    Mod+Alt+Shift+J { move-window-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+K { move-window-up; }
    Mod+Alt+Shift+K { move-window-up; }
    Mod+L { focus-column-right; }
    Mod+Shift+L { move-column-right; }
    Mod+Alt+Shift+L { move-column-right; }
    Mod+Left { move-column-left; }
    Mod+Down { move-window-down; }
    Mod+Up { move-window-up; }
    Mod+Right { move-column-right; }
    Mod+Alt+H { set-column-width "-20"; }
    Mod+Alt+L { set-column-width "+20"; }
    Mod+Alt+J { set-window-height "+20"; }
    Mod+Alt+K { set-window-height "-20"; }
    Mod+1 { focus-workspace 1; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Alt+1 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∀"; }
    Mod+Alt+2 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∃"; }
    Mod+Alt+3 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∈"; }
    Mod+Alt+4 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∉"; }
    Mod+Alt+5 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∩"; }
    Mod+Alt+6 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∪"; }
    Mod+Alt+7 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "→"; }
    Mod+Alt+8 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "↔"; }
    Mod+Alt+9 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "≤"; }
    Mod+Alt+0 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "≥"; }
    Mod+Alt+Shift+1 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "≠"; }
    Mod+Alt+Shift+2 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "±"; }
    Mod+Alt+Shift+3 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "×"; }
    Mod+Alt+Shift+4 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "÷"; }
    Mod+Alt+Shift+5 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "√"; }
    Mod+Alt+Shift+6 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∞"; }
    Mod+Alt+Shift+7 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∑"; }
    Mod+Alt+Shift+8 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∏"; }
    Mod+Alt+Shift+9 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∫"; }
    Mod+Alt+Shift+0 { spawn "/home/joaob/.config/niri/scripts/insert-math-symbol" "∂"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}
