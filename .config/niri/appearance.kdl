layout {
    gaps 0
    center-focused-column "on-overflow"
    background-color "#000000"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring { off; }
    border {
        width 1
        active-color "#9580bf"
        inactive-color "#302b3a"
        urgent-color "#f87171"
    }
}
prefer-no-csd
cursor {
    xcursor-theme "bloom-dark"
    xcursor-size 24
}
animations {
    slowdown 0.8
}
