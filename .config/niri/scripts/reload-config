#!/bin/sh
set -eu
if /usr/bin/niri validate; then
    if systemctl --user is-active --quiet niri-waybar.service; then
        systemctl --user reload niri-waybar.service
    fi
    notify-send 'Niri configuration' 'Valid. Saved settings reload automatically.'
else
    notify-send --urgency=critical 'Niri configuration' 'Validation failed. Run niri validate for details.'
    exit 1
fi
