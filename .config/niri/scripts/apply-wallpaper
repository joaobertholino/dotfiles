#!/usr/bin/python3
from pathlib import Path
import configparser,subprocess,time
for _ in range(100):
    if subprocess.run(['/usr/bin/awww','query','--namespace','niri'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:break
    time.sleep(0.1)
else:raise SystemExit('Wallpaper daemon did not become ready')
p=Path.home()/'.local/share/wallpapers/gentoo-violet-orbit-vertical-hd.gif'
c=configparser.ConfigParser()
c.read(Path.home()/'.config/waypaper/config.ini')
selected=Path(c.get('Settings','wallpaper',fallback=str(p))).expanduser()
if not selected.is_file():selected=p
if selected.is_file():
    subprocess.run(['/usr/bin/awww','img','--namespace','niri',str(selected),'--resize','fit','--filter','Nearest','--transition-type','none'],check=True)
else:
    subprocess.run(['/usr/bin/awww','clear','--namespace','niri','000000'],check=True)
