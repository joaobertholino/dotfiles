#!/usr/bin/python3
import datetime,subprocess,time,signal
child=None
running=True
def stop(signum,frame):
    global running
    running=False
signal.signal(signal.SIGTERM,stop)
signal.signal(signal.SIGINT,stop)
try:
    while running:
        now=datetime.datetime.now()
        night=now.hour<7
        if night and (child is None or child.poll() is not None):
            child=subprocess.Popen(['/usr/bin/wlsunset','-t','4500','-T','6500','-S','07:00','-s','00:00','-d','1'])
        elif not night and child is not None:
            child.terminate();child.wait(timeout=5);child=None
        boundary=now.replace(hour=7,minute=0,second=0,microsecond=0) if night else (now+datetime.timedelta(days=1)).replace(hour=0,minute=0,second=0,microsecond=0)
        delay=min(60,max(0.1,(boundary-now).total_seconds()))
        deadline=time.monotonic()+delay
        while running and time.monotonic()<deadline:time.sleep(min(1,max(0.01,deadline-time.monotonic())))
finally:
    if child is not None and child.poll() is None:
        child.terminate()
        try:child.wait(timeout=5)
        except subprocess.TimeoutExpired:child.kill();child.wait()
