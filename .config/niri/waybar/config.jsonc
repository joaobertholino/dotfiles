{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 2,
  "modules-left": [
    "niri/workspaces",
    "disk#root",
    "custom/filesystem-secondary"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/desktop-status",
    "custom/memory",
    "cpu",
    "network",
    "pulseaudio",
    "custom/mic"
  ],
  "disk#root": {
    "path": "/",
    "interval": 10,
    "format": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span> {percentage_used}%",
    "tooltip-format": "{path}: {used} / {total}"
  },
  "custom/filesystem-secondary": {
    "exec": "/home/joaob/.config/waybar/home-usage.sh",
    "interval": 10
  },
  "custom/memory": {
    "exec": "/home/joaob/.config/waybar/memory.sh",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "interval": 1,
    "format": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span> {usage}%",
    "tooltip": false
  },
  "network": {
    "interval": 1,
    "format-wifi": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span> {signalStrength}%",
    "format-ethernet": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
    "format-disconnected": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
    "tooltip": true,
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "headphone": "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
      "default": [
        "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
        "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>",
        "<span font_desc=\"Font Awesome 7 Free Solid 10\"></span>"
      ]
    }
  },
  "custom/mic": {
    "exec": "/home/joaob/.config/waybar/mic-activity.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "/home/joaob/.config/waybar/toggle-microphone.sh"
  },
  "clock": {
    "interval": 1,
    "format": "{:%d/%m · %H:%M}",
    "tooltip": true,
    "on-click": "/home/joaob/.config/niri/scripts/calendar-toggle",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/desktop-status": {
    "exec": "/home/joaob/.local/libexec/desktop-status",
    "return-type": "json",
    "interval": 3,
    "hide-empty-text": true,
    "on-click": "/usr/local/bin/alacritty -e /home/joaob/.local/libexec/desktop-status --details"
  },
  "niri/workspaces": {
    "format": "{value}",
    "all-outputs": true
  }
}
