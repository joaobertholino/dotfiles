{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 4,
  "modules-left": [
    "hyprland/workspaces",
    "disk#root",
    "custom/filesystem-secondary"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/memory",
    "cpu",
    "temperature",
    "network",
    "pulseaudio",
    "custom/mic"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
    "all-outputs": true,
    "persistent-workspaces": {
      "*": 5
    }
  },
  "disk#root": {
    "path": "/",
    "interval": 10,
    "format": "/ {percentage_used}%",
    "tooltip-format": "{path}: {used} usados de {total}"
  },
  "custom/filesystem-secondary": {
    "exec": "mountpoint -q /home && df -h /home | awk 'NR==2 {print \"/home \" $5}' || printf '/home não montado'",
    "interval": 10,
    "tooltip-format": "{path}: {used} usados de {total}"
  },
  "custom/memory": {
    "exec": "/home/joaob/.config/waybar/memory.sh",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "interval": 1,
    "format": "CPU: {usage}%",
    "tooltip": false
  },
  "temperature": {
    "interval": 1,
    "critical-threshold": 50,
    "format": "CPU-TEMP: {temperatureC}°C",
    "format-critical": "CPU-TEMP: {temperatureC}°C",
    "tooltip": false
  },
  "network": {
    "interval": 1,
    "format-wifi": "WIFI: Connected",
    "format-ethernet": "Ethernet: Connected",
    "format-disconnected": "Connection: Disconnected",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/mic": {
    "exec": "/home/joaob/.config/waybar/mic-activity.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "/home/joaob/.config/waybar/toggle-microphone.sh"
  },
  "clock": {
    "interval": 1,
    "format": "{:%A - %d/%b(%m)/%Y - %H:%M}",
    "format-alt": "{:%H:%M}",
    "tooltip": false
  }
}
