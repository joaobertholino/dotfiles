#!/bin/bash
# Minimal bridge: import the live compositor environment, then activate systemd units.
set -eu
unset LIBGL_DRIVERS_PATH __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH QT_PLUGIN_PATH
variables=(PATH DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
 XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS
 XDG_CONFIG_DIRS XDG_CONFIG_HOME FONTCONFIG_FILE LIBGL_DRIVERS_PATH
 GBM_BACKENDS_PATH __EGL_VENDOR_LIBRARY_FILENAMES XCURSOR_PATH
 XCURSOR_SIZE XCURSOR_THEME HYPRCURSOR_SIZE HYPRCURSOR_THEME
 QT_PLUGIN_PATH QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE
 GDK_BACKEND GTK_THEME GTK2_RC_FILES GTK_USE_PORTAL
 SDL_VIDEODRIVER CLUTTER_BACKEND MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT)
present=()
for variable in "${variables[@]}"; do
    if [[ -v $variable ]]; then present+=("$variable"); fi
done
/usr/bin/dbus-update-activation-environment --systemd "${present[@]}"
exec /usr/bin/systemctl --user start hyprland-session.target
