#!/bin/bash
set -eu
export PATH="/home/joaob/.local/share/texlive/2026/bin/x86_64-linux:/home/joaob/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export XDG_DATA_DIRS="/home/joaob/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/home/joaob/.local/share:/usr/local/share:/usr/share"
export FONTCONFIG_FILE="/etc/fonts/gentoo-desktop.conf"
export XKB_CONFIG_ROOT="/usr/share/X11/xkb"
export XCURSOR_PATH="/home/joaob/.icons:/usr/share/icons:/usr/share/pixmaps"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export LIBSEAT_BACKEND=logind
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:?}/bus"
unset LIBGL_DRIVERS_PATH GBM_BACKENDS_PATH __EGL_VENDOR_LIBRARY_FILENAMES
unset LD_LIBRARY_PATH LD_PRELOAD QT_PLUGIN_PATH QML2_IMPORT_PATH QML_IMPORT_PATH
unset GIO_EXTRA_MODULES GI_TYPELIB_PATH GTK_PATH THUNARX_DIRS
mkdir -p "$HOME/.local/state"
exec /usr/bin/start-hyprland --no-nixgl -- "$@" > "$HOME/.local/state/hyprland-session.log" 2>&1
