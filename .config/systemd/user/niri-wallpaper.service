[Unit]
Description=Gentoo animated wallpaper for Niri
PartOf=niri.service graphical-session.target
Requisite=niri.service
After=niri.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
UnsetEnvironment=HYPRLAND_INSTANCE_SIGNATURE
Type=exec
EnvironmentFile=%h/.config/niri/session.env
ExecStart=/usr/bin/awww-daemon --namespace niri --no-cache
ExecStartPost=%h/.config/niri/scripts/apply-wallpaper
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
[Install]
WantedBy=niri.service
