[Unit]
Description=Manually lock the Niri session
PartOf=niri.service graphical-session.target
Requisite=niri.service
After=niri.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
UnsetEnvironment=HYPRLAND_INSTANCE_SIGNATURE
Type=exec
EnvironmentFile=%h/.config/niri/session.env
ExecStart=/usr/bin/hyprlock --grace 0 --config %h/.config/niri/lock.conf
