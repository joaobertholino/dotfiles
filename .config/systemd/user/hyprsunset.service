[Unit]
Description=Night light from midnight to 07:00
PartOf=hyprland-session.target graphical-session.target
Requisite=hyprland-session.target
After=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/local/bin/hyprsunset
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=hyprland-session.target
