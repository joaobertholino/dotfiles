!/.config/systemd/user/clipboard-history.service
!/.local/libexec/
!/.local/libexec/clipboard-store
!/.local/libexec/clipboard-watch
!/.local/libexec/desktop-status
!/.local/bin/clipboard-history
!/.local/bin/night-light-toggle

**/__pycache__/
*.pyc
/.config/gtk-3.0/bookmarks

!/.config/prelude-personal/
/.config/prelude/

!/.config/systemd/user/hyprlauncher.service

!/.config/xdg-desktop-portal/
/.config/xdg-desktop-portal/*
!/.config/xdg-desktop-portal/hyprland-portals.conf
!/.config/xdg-desktop-portal/sway-portals.conf
