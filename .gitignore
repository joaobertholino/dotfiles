# Ignorar tudo no diretório HOME
/*

# Não ignorar os seguintes arquivos específicos
!/.vimrc
!/.bashrc
!/.bash_aliases
!/README.md
!/.gitignore
!/.gitmodules

# Não ignorar o diretório .config, mas ignorar seu conteúdo por padrão
!/.config/
/.config/*

# Não ignorar diretórios específicos dentro de .config e seus conteúdos
!/.config/alacritty/
!/.config/alacritty/**
!/.config/tmux/
!/.config/tmux/**
!/.config/rofi/
!/.config/rofi/**
!/.config/htop/
!/.config/htop**
!/.config/xournalpp/
!/.config/xournalpp/**
!/.config/yay/
!/.config/yay/**
!/.config/ranger/
!/.config/ranger/**
!/.config/doom/
!/.config/doom/**
!/.config/gigolo/
!/.config/gigolo/**
!/.config/zathura/
!/.config/zathura/**
!/.config/ly-dur/
!/.config/ly-dur/**
!/.config/hypr/
!/.config/hypr/**
!/.config/waybar/
!/.config/waybar/**
