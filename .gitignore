# Ignorar tudo no diretório HOME
/*

# Não ignorar os seguintes arquivos específicos
!/.vimrc
!/.bashrc
!/.bash_aliases
!/README.md
!/.gitignore
!/.gitmodules

# Não ignorar o diretório .config, mas ignorar seu conteúdo por padrão
!/.config/
/.config/*

# Não ignorar diretórios específicos dentro de .config e seus conteúdos
!/.config/alacritty/
!/.config/alacritty/**
!/.config/tmux/
!/.config/tmux/**
!/.config/htop/
!/.config/htop**
!/.config/xournalpp/
!/.config/xournalpp/**
!/.config/yay/
!/.config/yay/**
!/.config/doom/
!/.config/doom/**
!/.config/gigolo/
!/.config/gigolo/**
!/.config/zathura/
!/.config/zathura/**
!/.config/ly-dur/
!/.config/ly-dur/**
!/.config/hypr/
!/.config/hypr/**
!/.config/waybar/
!/.config/waybar/**
!/.config/ly-dm/
!/.config/ly-dm/**

# Configuração de notificações versionada como submódulo
!/.config/dunst/

# Calendário da Waybar versionado como submódulo
!/.config/zen-cal/

# Integração Gentoo, Thunar e automação de dotfiles.
!/.bash_profile
!/.profile
!/.config/Thunar/
!/.config/Thunar/**
!/.config/xfce4/
/.config/xfce4/*
!/.config/xfce4/xfconf/
/.config/xfce4/xfconf/*
!/.config/xfce4/xfconf/xfce-perchannel-xml/
/.config/xfce4/xfconf/xfce-perchannel-xml/*
!/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
!/.config/xfce4/xfconf/xfce-perchannel-xml/thunar-volman.xml
!/.config/systemd/
/.config/systemd/*
!/.config/systemd/user/
/.config/systemd/user/*
!/.config/systemd/user/git-auto-push.service
!/.config/systemd/user/git-auto-push.timer
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/auto-push.sh
!/.config/systemd/user/thunar.service
!/.config/systemd/user/tumblerd.service
!/.local/share/
/.local/share/*
!/.local/share/dbus-1/
/.local/share/dbus-1/*
!/.local/share/dbus-1/services/
/.local/share/dbus-1/services/*
!/.local/share/dbus-1/services/org.xfce.Thunar.service
!/.local/share/dbus-1/services/org.xfce.Thunar.FileManager1.service
!/.local/share/dbus-1/services/org.xfce.FileManager.service
!/.local/share/dbus-1/services/org.xfce.Tumbler.Cache1.service
!/.local/share/dbus-1/services/org.xfce.Tumbler.Manager1.service
!/.local/share/dbus-1/services/org.xfce.Tumbler.Thumbnailer1.service

!/.config/desktop-integration/
!/.config/desktop-integration/**
!/.config/cliphist/
!/.config/cliphist/config
!/.config/fuzzel/
!/.config/fuzzel/fuzzel.ini
!/.config/Kvantum/
!/.config/Kvantum/**
!/.config/gtk-3.0/
!/.config/gtk-3.0/settings.ini
!/.config/gtk-3.0/gtk.css
!/.config/gtk-4.0/
!/.config/gtk-4.0/settings.ini
!/.config/gtk-4.0/gtk.css
